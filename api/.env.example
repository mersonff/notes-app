# --- Database ---
# Single source of truth for ActiveRecord (12-factor: config via env).
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes_app_development
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes_app_test

# --- Rails ---
# Generate with: bundle exec rails secret
SECRET_KEY_BASE=replace_me_with_a_long_random_string

# Send Rails logs to STDOUT instead of files (12-factor logs).
RAILS_LOG_TO_STDOUT=true

# Comma-separated list of origins allowed by CORS.
# Use "*" only in development; never in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Pagination ---
# Default and maximum page size enforced by the API.
PAGY_DEFAULT_ITEMS=20
PAGY_MAX_ITEMS=100

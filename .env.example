# --- Database (consumed by the db and api services) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notes_app_production

# --- Rails (api service) ---
# Generate with: cd api && bundle exec rails secret
SECRET_KEY_BASE=replace_me_with_a_long_random_string

# Log verbosity inside the api container
RAILS_LOG_LEVEL=info

# Comma-separated list of origins allowed by CORS.
# Should include the URL the SPA is served from (default: web container on 8080).
CORS_ORIGINS=http://localhost:8080

# Pagination tunables (env-driven so the same image can be tuned per env)
PAGY_DEFAULT_ITEMS=20
PAGY_MAX_ITEMS=100

# --- Web (host port for the SPA) ---
WEB_PORT=8080
